Subject: [PATCH] NFC: rawsock: deactivate the target in socket release context

The last in-flight reference may be dropped from the NCI receive worker.
Do not synchronously wait for controller deactivation from that destructor:
the receive worker is also needed to complete the deactivation request.
Stop pending sends and deactivate while socket release still holds its
reference. Retain the device reference until final destruction.

Upstream-Status: Pending

diff --git a/net/nfc/rawsock.c b/net/nfc/rawsock.c
index b927730d9ab0..453b30dee188 100644
--- a/net/nfc/rawsock.c
+++ b/net/nfc/rawsock.c
@@ -75,8 +75,21 @@ static int rawsock_release(struct socket *sock)
 	if (!sk)
 		return 0;
 
-	if (sock->type == SOCK_RAW)
+	if (sock->type == SOCK_RAW) {
 		nfc_sock_unlink(&raw_sk_list, sk);
+	} else {
+		/* Keep the file's socket reference while stopping sends.
+		 * Deactivation may wait for the NCI receive worker, so do
+		 * it here instead of in a destructor reached by that worker.
+		 */
+		sk->sk_shutdown = SHUTDOWN_MASK;
+		cancel_work_sync(&nfc_rawsock(sk)->tx_work);
+		rawsock_write_queue_purge(sk);
+		if (sk->sk_state == TCP_ESTABLISHED)
+			nfc_deactivate_target(nfc_rawsock(sk)->dev,
+					      nfc_rawsock(sk)->target_idx,
+					      NFC_TARGET_MODE_IDLE);
+	}
 
 	sock_orphan(sk);
 	sock_put(sk);
@@ -320,9 +333,6 @@ static void rawsock_destruct(struct sock *sk)
 	pr_debug("sk=%p\n", sk);
 
 	if (sk->sk_state == TCP_ESTABLISHED) {
-		nfc_deactivate_target(nfc_rawsock(sk)->dev,
-				      nfc_rawsock(sk)->target_idx,
-				      NFC_TARGET_MODE_IDLE);
 		nfc_put_device(nfc_rawsock(sk)->dev);
 	}
 
