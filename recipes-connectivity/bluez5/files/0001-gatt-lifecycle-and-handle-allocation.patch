+	gatt_db_ccc_register(db, NULL, NULL, allocation_notify, NULL);
+	service = gatt_db_insert_service(db, 0x0100, &uuid, true, 16);
+	g_assert_nonnull(service);
+	/* Reverse insertion with holes, then an automatic characteristic. */
+	high = gatt_db_service_insert_characteristic(service, 0x0108, 0x0109,
+			&uuid, BT_ATT_PERM_READ, BT_GATT_CHRC_PROP_NOTIFY,
+			NULL, NULL, NULL);
+	low = gatt_db_service_insert_characteristic(service, 0x0104, 0x0105,
+			&uuid, BT_ATT_PERM_READ, BT_GATT_CHRC_PROP_NOTIFY,
+			NULL, NULL, NULL);
+	automatic = gatt_db_service_add_characteristic(service, &uuid,
+			BT_ATT_PERM_READ, BT_GATT_CHRC_PROP_NOTIFY, NULL, NULL, NULL);
+	g_assert_nonnull(high);
+	g_assert_nonnull(low);
+	g_assert_nonnull(automatic);
+	g_assert_cmpuint(gatt_db_attribute_get_handle(automatic), ==, 0x0102);
+
+	ccc = gatt_db_characteristic_add_ccc(low, BT_ATT_PERM_READ);
+	g_assert_nonnull(ccc);
+	g_assert_cmpuint(gatt_db_attribute_get_handle(ccc), ==, 0x0106);
+	ccc = gatt_db_characteristic_add_ccc(high, BT_ATT_PERM_READ);
+	g_assert_nonnull(ccc);
+	g_assert_cmpuint(gatt_db_attribute_get_handle(ccc), ==, 0x010a);
+	ccc = gatt_db_characteristic_add_ccc(automatic, BT_ATT_PERM_READ);
+	g_assert_nonnull(ccc);
+	g_assert_cmpuint(gatt_db_attribute_get_handle(ccc), ==, 0x0103);
+	g_assert_null(gatt_db_characteristic_add_ccc(low, BT_ATT_PERM_READ));
+	g_assert_null(gatt_db_characteristic_add_ccc(service, BT_ATT_PERM_READ));
+
+	/* A descriptor may not precede its value, cross the next declaration,
+	 * overwrite an occupied slot, or wrap at the service end. */
+	g_assert_null(gatt_db_characteristic_insert_descriptor(low, 0x0103,
+			&desc_uuid, BT_ATT_PERM_READ, NULL, NULL, NULL));
+	g_assert_null(gatt_db_characteristic_insert_descriptor(low, 0x010b,
+			&desc_uuid, BT_ATT_PERM_READ, NULL, NULL, NULL));
+	g_assert_null(gatt_db_characteristic_insert_descriptor(low, 0x0106,
+			&desc_uuid, BT_ATT_PERM_READ, NULL, NULL, NULL));
+	desc = gatt_db_characteristic_insert_descriptor(low, 0, &desc_uuid,
+			BT_ATT_PERM_READ, NULL, NULL, NULL);
+	g_assert_nonnull(desc);
+	g_assert_cmpuint(gatt_db_attribute_get_handle(desc), ==, 0x0107);
+	g_assert_null(gatt_db_characteristic_insert_descriptor(low, 0, &desc_uuid,
