+/* Database range validation: adjacent allocations are valid, intersections
+ * in either direction are rejected, and failed insertions preserve contents. */
+static void test_service_ranges(const void *user_data)
+{
+	struct gatt_db *db = gatt_db_new();
+	struct gatt_db_attribute *service;
+	bt_uuid_t uuid, other;
+
+	bt_uuid16_create(&uuid, 0x1800);
+	bt_uuid16_create(&other, 0x1801);
+	service = gatt_db_insert_service(db, 0x0100, &uuid, true, 8);
+	g_assert_nonnull(service);
+	g_assert_null(gatt_db_insert_service(db, 0x00ff, &other, true, 10));
+	g_assert_null(gatt_db_insert_service(db, 0x0101, &other, true, 2));
+	g_assert_null(gatt_db_insert_service(db, 0x00ff, &other, true, 2));
+	g_assert_null(gatt_db_insert_service(db, 0x0107, &other, true, 2));
+	g_assert_true(gatt_db_get_attribute(db, 0x0100) == service);
+	g_assert_nonnull(gatt_db_insert_service(db, 0x00f8, &other, true, 8));
+	g_assert_nonnull(gatt_db_insert_service(db, 0x0108, &other, true, 8));
+	gatt_db_unref(db);
+	tester_test_passed();
+}
