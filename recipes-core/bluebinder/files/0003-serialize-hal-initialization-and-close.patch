+static void configure_bt(struct proxy *proxy, gboolean bluetooth_on);
+static gboolean process_packets_once(gpointer user_data);
+
+static void
+cancel_lifecycle(struct proxy *proxy)
+{
+    if (proxy->hal_transaction) {
+        gbinder_client_cancel(proxy->binder_client, proxy->hal_transaction);
+        proxy->hal_transaction = 0;
+    }
+    if (proxy->hal_timeout) {
+        g_source_remove(proxy->hal_timeout);
+        proxy->hal_timeout = 0;
+    }
+    if (proxy->shutdown_timeout) {
+        g_source_remove(proxy->shutdown_timeout);
+        proxy->shutdown_timeout = 0;
+    }
+    if (proxy->reconcile_id) {
+        g_source_remove(proxy->reconcile_id);
+        proxy->reconcile_id = 0;
+    }
+}
+
+static void
+lifecycle_failed(struct proxy *proxy)
+{
+    /* A failed transport cannot safely run another CLOSE. Recreate the proxy
+     * and vhci together; the supplied service supervises process recovery. */
+    proxy->failed = TRUE;
+    proxy->bluetooth_hal_initialized = FALSE;
+    cancel_lifecycle(proxy);
+    g_main_loop_quit(proxy->loop);
+}
+
+static gboolean
+lifecycle_timed_out(gpointer user_data)
+{
+    struct proxy *proxy = user_data;
+    fprintf(stderr, "Bluetooth lifecycle timed out; exiting\n");
+    lifecycle_failed(proxy);
+    return G_SOURCE_REMOVE;
+}
+
+static gboolean
+reconcile_bt(gpointer user_data)
+{
+    struct proxy *proxy = user_data;
+    proxy->reconcile_id = 0;
+    configure_bt(proxy, proxy->bluetooth_requested);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+schedule_reconcile(struct proxy *proxy)
+{
+    if (!proxy->failed && !proxy->reconcile_id)
+        proxy->reconcile_id = g_idle_add_full(PRIORITY_RFKILL_CHANNEL,
+            reconcile_bt, proxy, NULL);
+}
+
+static void
+initialize_ready(struct proxy *proxy)
+{
+    /* The method reply and INITIALIZATION_COMPLETE may arrive in either order.
+     * Never CLOSE until both have arrived and their callbacks have returned. */
+    if (proxy->failed || proxy->hal_pending != HAL_INITIALIZE ||
+        proxy->hal_transaction || !proxy->initialize_complete)
+        return;
+    proxy->hal_pending = HAL_IDLE;
+    proxy->bluetooth_hal_initialized = TRUE;
+    if (proxy->startup_complete && proxy->hal_timeout) {
+        g_source_remove(proxy->hal_timeout);
+        proxy->hal_timeout = 0;
+    }
+    /* At startup the same deadline also bounds kernel HCI setup. */
+    g_idle_add_full(PRIORITY_PROCESS_PACKETS_ONCE, process_packets_once, proxy, NULL);
+    schedule_reconcile(proxy);
+}
+
+static void
+hal_reply(GBinderClient *client, GBinderRemoteReply *reply,
+          int status, void *user_data)
+{
+    struct proxy *proxy = user_data;
+    if (proxy->failed || client != proxy->binder_client || !proxy->hal_transaction)
+        return;
+    proxy->hal_transaction = 0;
+    if (status != GBINDER_STATUS_OK || !reply) {
+        fprintf(stderr, "Bluetooth HAL transaction failed: %d\n", status);
+        lifecycle_failed(proxy);
+    } else if (proxy->hal_pending == HAL_INITIALIZE) {
+        initialize_ready(proxy);
+    } else {
+        proxy->hal_pending = HAL_IDLE;
+        g_source_remove(proxy->hal_timeout);
+        proxy->hal_timeout = 0;
+        schedule_reconcile(proxy);
+    }
+}
