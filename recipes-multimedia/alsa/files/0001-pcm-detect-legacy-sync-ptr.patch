+#if defined(__SND_STRUCT_TIME64) && __SIZEOF_LONG__ == 4
+/* Pre-time64 kernel UAPI layout: all frame counts and timestamps are 32-bit. */
+struct snd_pcm_status_legacy {
+    __s32 state;
+    struct __snd_timespec trigger_tstamp;
+    struct __snd_timespec tstamp;
+    __u32 appl_ptr, hw_ptr;
+    __s32 delay;
+    __u32 avail, avail_max, overrange;
+    __s32 suspended_state;
+    __u32 audio_tstamp_data;
+    struct __snd_timespec audio_tstamp;
+    struct __snd_timespec driver_tstamp;
+    __u32 audio_tstamp_accuracy;
+    unsigned char reserved[36];
+};
+_Static_assert(sizeof(struct snd_pcm_status_legacy) == 108, "legacy PCM status ABI");
+#endif
+
+static int snd_pcm_hw_status_ioctl(snd_pcm_hw_t *hw, unsigned int cmd,
+                                   snd_pcm_status_t *status)
+{
+#if defined(__SND_STRUCT_TIME64) && __SIZEOF_LONG__ == 4
+    struct snd_pcm_status_legacy legacy;
+    unsigned int bit = cmd == SNDRV_PCM_IOCTL_STATUS_EXT ? 2 : 1;
+    unsigned int legacy_cmd;
+    int ret;
+
+    if (!(hw->status_legacy_mask & bit)) {
+        ret = ioctl(hw->fd, cmd, status);
+        if (ret >= 0 || errno != ENOTTY)
+            return ret;
+    }
+    memset(&legacy, 0, sizeof(legacy));
+    /* STATUS_EXT accepts the requested audio timestamp type as input. */
+    if (cmd == SNDRV_PCM_IOCTL_STATUS_EXT)
+        legacy.audio_tstamp_data = status->audio_tstamp_data;
+    legacy_cmd = cmd == SNDRV_PCM_IOCTL_STATUS_EXT ?
+        _IOWR('A', 0x24, struct snd_pcm_status_legacy) :
+        _IOR('A', 0x20, struct snd_pcm_status_legacy);
+    ret = ioctl(hw->fd, legacy_cmd, &legacy);
+    if (ret < 0)
+        return ret;
+
+    memset(status, 0, sizeof(*status));
+    status->state = legacy.state;
+    status->trigger_tstamp.tv_sec = legacy.trigger_tstamp.tv_sec;
+    status->trigger_tstamp.tv_nsec = legacy.trigger_tstamp.tv_nsec;
+    status->tstamp.tv_sec = legacy.tstamp.tv_sec;
+    status->tstamp.tv_nsec = legacy.tstamp.tv_nsec;
+    status->appl_ptr = legacy.appl_ptr;
+    status->hw_ptr = legacy.hw_ptr;
+    status->delay = legacy.delay;
+    status->avail = legacy.avail;
+    status->avail_max = legacy.avail_max;
+    status->overrange = legacy.overrange;
+    status->suspended_state = legacy.suspended_state;
+    status->audio_tstamp_data = legacy.audio_tstamp_data;
+    status->audio_tstamp.tv_sec = legacy.audio_tstamp.tv_sec;
+    status->audio_tstamp.tv_nsec = legacy.audio_tstamp.tv_nsec;
+    status->driver_tstamp.tv_sec = legacy.driver_tstamp.tv_sec;
+    status->driver_tstamp.tv_nsec = legacy.driver_tstamp.tv_nsec;
+    status->audio_tstamp_accuracy = legacy.audio_tstamp_accuracy;
+    hw->status_legacy_mask |= bit;
+    return ret;
+#else
+    return ioctl(hw->fd, cmd, status);
+#endif
+}
+
